{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitrans.app/schemas/provable-agent-reference/agentic-common.schema.json",
  "title": "Experimental Agentic Contract Common Definitions",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{2,199}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableDigest": {
      "anyOf": [
        {"$ref": "#/$defs/digest"},
        {"type": "null"}
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "timeAssurance": {
      "enum": [
        "unavailable",
        "source_declared",
        "control_plane_observed",
        "provider_attested",
        "trusted_time"
      ]
    },
    "classification": {
      "enum": ["public", "internal", "confidential", "restricted", "regulated"]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "issuer", "actor_type"],
      "properties": {
        "subject": {"type": "string", "minLength": 1, "maxLength": 500},
        "issuer": {"type": "string", "minLength": 1, "maxLength": 2000},
        "actor_type": {
          "enum": [
            "requester",
            "agent_runtime",
            "agent",
            "tool_gateway",
            "evidence_resolver",
            "control_plane",
            "human_approver",
            "effect_executor",
            "packet_issuer",
            "independent_verifier"
          ]
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "adapter_version"],
      "properties": {
        "adapter_id": {"$ref": "#/$defs/identifier"},
        "adapter_version": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "content_commitment",
        "source_ref",
        "provenance_ref",
        "classification",
        "freshness_status",
        "integrity_status"
      ],
      "properties": {
        "reference_id": {"type": "string", "minLength": 1, "maxLength": 500},
        "content_commitment": {"$ref": "#/$defs/digest"},
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 500},
        "provenance_ref": {"type": "string", "minLength": 1, "maxLength": 500},
        "classification": {"$ref": "#/$defs/classification"},
        "freshness_status": {"enum": ["current", "stale", "unknown"]},
        "integrity_status": {"enum": ["verified", "failed", "unknown"]}
      }
    }
  }
}
