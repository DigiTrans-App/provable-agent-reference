{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitrans.app/schemas/provable-agent-reference/semantic-draft.schema.json",
  "title": "Semantic Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_text",
    "selected_evidence_id",
    "limitations",
    "assurance_statement",
    "content_categories",
    "redacted"
  ],
  "properties": {
    "claim_text": {"type": "string", "minLength": 1, "maxLength": 4000},
    "selected_evidence_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "assurance_statement": {"type": "string", "minLength": 1, "maxLength": 8000},
    "content_categories": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "redacted": {"type": "boolean"}
  }
}
