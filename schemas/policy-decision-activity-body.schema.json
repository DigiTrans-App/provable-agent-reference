{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitrans.app/schemas/provable-agent-reference/policy-decision-activity-body.schema.json",
  "title": "Experimental Policy Decision Activity Body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body_type",
    "policy_bundle_id",
    "policy_bundle_version",
    "decision",
    "subject_hash",
    "action_hash",
    "resource_hash",
    "context_hash",
    "obligations",
    "reason_codes"
  ],
  "properties": {
    "body_type": {"const": "policy_decision"},
    "policy_bundle_id": {"$ref": "agentic-common.schema.json#/$defs/identifier"},
    "policy_bundle_version": {"type": "string", "minLength": 1, "maxLength": 100},
    "decision": {"enum": ["allow", "deny", "conditional", "unknown"]},
    "subject_hash": {"$ref": "agentic-common.schema.json#/$defs/digest"},
    "action_hash": {"$ref": "agentic-common.schema.json#/$defs/digest"},
    "resource_hash": {"$ref": "agentic-common.schema.json#/$defs/digest"},
    "context_hash": {"$ref": "agentic-common.schema.json#/$defs/digest"},
    "obligations": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,99}$"}
    }
  }
}
