{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitrans.app/schemas/provable-agent-reference/delegation-activity-body.schema.json",
  "title": "Experimental Delegation Activity Body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body_type",
    "delegation_id",
    "parent_subject",
    "child_subject",
    "task",
    "capability_grant",
    "budget",
    "valid_until",
    "status"
  ],
  "properties": {
    "body_type": {"const": "delegation"},
    "delegation_id": {"$ref": "agentic-common.schema.json#/$defs/identifier"},
    "parent_subject": {"type": "string", "minLength": 1, "maxLength": 500},
    "child_subject": {"type": "string", "minLength": 1, "maxLength": 500},
    "task": {"type": "string", "minLength": 1, "maxLength": 4000},
    "capability_grant": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"$ref": "agentic-common.schema.json#/$defs/identifier"}
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tool_calls", "max_model_calls"],
      "properties": {
        "max_tool_calls": {"type": "integer", "minimum": 0, "maximum": 10000},
        "max_model_calls": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    },
    "valid_until": {"$ref": "agentic-common.schema.json#/$defs/timestamp"},
    "status": {"enum": ["granted", "narrowed", "expired", "revoked"]}
  }
}
