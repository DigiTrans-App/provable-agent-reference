{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitrans.app/schemas/provable-agent-reference/agentic-conformance-report.schema.json",
  "title": "Experimental Agentic Conformance Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "generated_at",
    "claim_scope",
    "core_profile_status",
    "self_issued",
    "implementation",
    "protocol_version",
    "vector_revision",
    "core_profiles",
    "capability_results",
    "storage_assurance",
    "environment",
    "limitations",
    "report_hash"
  ],
  "properties": {
    "$schema": {
      "const": "https://digitrans.app/schemas/provable-agent-reference/agentic-conformance-report.schema.json"
    },
    "schema_version": {
      "const": "0.1-draft"
    },
    "generated_at": {
      "$ref": "agentic-common.schema.json#/$defs/timestamp"
    },
    "claim_scope": {
      "const": "core_profiles_only"
    },
    "core_profile_status": {
      "enum": [
        "pass",
        "fail",
        "incomplete"
      ]
    },
    "self_issued": {
      "const": true
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "source_revision",
        "language"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "source_revision": {
          "type": "string",
          "minLength": 7,
          "maxLength": 200
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "protocol_version": {
      "const": "0.3.0-candidate.1"
    },
    "vector_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "core_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "prefixItems": [
        {
          "const": "par.core.v1"
        },
        {
          "const": "par.evidence-bound.v1"
        },
        {
          "const": "par.governed.v1"
        },
        {
          "const": "par.exact-use.v1"
        },
        {
          "const": "par.reconstructable.v1"
        }
      ],
      "items": false
    },
    "capability_results": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "status",
          "dependencies",
          "checks",
          "limitations"
        ],
        "properties": {
          "capability_id": {
            "enum": [
              "par.capability.activity-bound.0.1-draft",
              "par.capability.authenticated-records.0.1-draft",
              "par.capability.receipted-effect.0.1-draft",
              "par.capability.private-memory.0.1-draft",
              "par.capability.durable-lifecycle.0.1-draft"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_tested",
              "not_applicable"
            ]
          },
          "dependencies": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "checks": {
            "type": "array",
            "maxItems": 500,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "limitations": {
            "$ref": "agentic-common.schema.json#/$defs/limitations"
          }
        }
      }
    },
    "storage_assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "status",
        "self_issued",
        "tested_at",
        "limitations"
      ],
      "properties": {
        "level": {
          "enum": [
            "S0",
            "S1",
            "S2",
            "S3"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "incomplete"
          ]
        },
        "self_issued": {
          "type": "boolean"
        },
        "tested_at": {
          "$ref": "agentic-common.schema.json#/$defs/timestamp"
        },
        "limitations": {
          "$ref": "agentic-common.schema.json#/$defs/limitations"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "runtime",
        "architecture"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "limitations": {
      "$ref": "agentic-common.schema.json#/$defs/limitations"
    },
    "report_hash": {
      "$ref": "agentic-common.schema.json#/$defs/digest"
    }
  }
}
