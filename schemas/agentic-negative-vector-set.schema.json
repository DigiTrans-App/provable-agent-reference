{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitrans.app/schemas/provable-agent-reference/agentic-negative-vector-set.schema.json",
  "title": "Experimental Agentic Negative Vector Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "vector_version", "cases"],
  "properties": {
    "$schema": {
      "const": "https://digitrans.app/schemas/provable-agent-reference/agentic-negative-vector-set.schema.json"
    },
    "vector_version": {"const": "0.1-draft"},
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "schema", "base_example", "mutations", "expected_invalid", "failure_class"],
        "properties": {
          "case_id": {"$ref": "agentic-common.schema.json#/$defs/identifier"},
          "schema": {"type": "string", "pattern": "^[a-z0-9-]+\\.schema\\.json$"},
          "base_example": {"type": "string", "pattern": "^[a-z0-9-]+\\.example\\.json$"},
          "mutations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "path"],
              "properties": {
                "operation": {"enum": ["add", "replace", "remove"]},
                "path": {"type": "string", "pattern": "^/(?:[^~/]|~[01])+(?:/(?:[^~/]|~[01])+)*$"},
                "value": {}
              },
              "allOf": [
                {
                  "if": {"properties": {"operation": {"enum": ["add", "replace"]}}},
                  "then": {"required": ["value"]},
                  "else": {"not": {"required": ["value"]}}
                }
              ]
            }
          },
          "expected_invalid": {"const": true},
          "failure_class": {
            "enum": ["schema", "scope", "binding", "replay", "downgrade", "privacy", "effect", "trust"]
          }
        }
      }
    }
  }
}
