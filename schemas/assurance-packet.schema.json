{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitrans.app/schemas/provable-agent-reference/assurance-packet.schema.json",
  "title": "Provable Agent Assurance Packet Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "protocol_version",
    "packet_id",
    "claimed_profiles",
    "lifecycle",
    "evidence_bundle",
    "records",
    "authorized_output",
    "limitations",
    "created_at",
    "packet_hash"
  ],
  "properties": {
    "$schema": {
      "const": "https://digitrans.app/schemas/provable-agent-reference/assurance-packet.schema.json"
    },
    "protocol_version": {"const": "0.3.0-candidate.1"},
    "packet_id": {"type": "string", "pattern": "^packet_[0-9a-f]{24}$"},
    "claimed_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "prefixItems": [
        {"const": "par.core.v1"},
        {"const": "par.evidence-bound.v1"},
        {"const": "par.governed.v1"},
        {"const": "par.exact-use.v1"},
        {"const": "par.reconstructable.v1"}
      ],
      "items": false
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {"state": {"const": "reconstructed"}}
    },
    "evidence_bundle": {"$ref": "evidence-bundle.schema.json"},
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "verification",
        "approval",
        "authorization",
        "audit_manifest"
      ],
      "properties": {
        "candidate": {"$ref": "canonical-candidate.schema.json"},
        "verification": {"$ref": "verification-result.schema.json"},
        "approval": {"$ref": "approval-record.schema.json"},
        "authorization": {"$ref": "authorization-result.schema.json"},
        "audit_manifest": {"$ref": "audit-manifest.schema.json"}
      }
    },
    "authorized_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assurance_statement", "limitations"],
      "properties": {
        "assurance_statement": {"type": "string", "minLength": 1, "maxLength": 8000},
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "packet_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
